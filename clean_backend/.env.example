# Environment variables for the Go Crypto Bot Backend
# Copy this file to .env and fill in your actual values.
# DO NOT COMMIT .env TO VERSION CONTROL.

# General Application Configuration
ENVIRONMENT=development # development, staging, production
LOG_LEVEL=debug # debug, info, warn, error, fatal, panic
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
DEBUG=false # Enable debug logging (true/false)

# Database Configuration (Turso)
DATABASE_TYPE=turso
DATABASE_DSN=libsql://local.db
TURSO_DB_URL=libsql://your-db-name.turso.io # Replace with your Turso database URL
TURSO_AUTH_TOKEN=your_turso_auth_token # Replace with your Turso auth token
TURSO_SYNC_ENABLED=true
TURSO_SYNC_INTERVAL_SECONDS=300

# MEXC API Configuration
MEXC_API_KEY=YOUR_MEXC_API_KEY # Replace with your MEXC API key
MEXC_SECRET_KEY=YOUR_MEXC_SECRET_KEY # Replace with your MEXC secret key
MEXC_BASE_URL=https://api.mexc.com
MEXC_WEBSOCKET_URL=wss://wbs.mexc.com/ws

# Encryption Configuration (REQUIRED - Generate using 'go run ./cmd/keygen generate-config')
# Example (DO NOT USE THIS IN PRODUCTION):
# CURRENT_KEY_ID=key1
# ENCRYPTION_KEYS='{"key1":"base64_encoded_32_byte_key_1","key2":"base64_encoded_32_byte_key_2"}'
CURRENT_KEY_ID=default # Replace with your key ID
ENCRYPTION_KEYS=[{"id":"default","key":"YOUR_BASE64_ENCODED_KEY"}] # Replace with your encryption keys

# Authentication Configuration (Clerk)
AUTH_ENABLED=true
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY # Replace with your Clerk secret key
CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY # Replace with your Clerk publishable key
CLERK_DOMAIN=https://api.clerk.com
CLERK_JWT_TEMPLATE=api_auth

# Telegram Notifications (Optional)
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# AI Provider Configuration
# Replace these with your actual API keys if needed
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY
MODEL=claude-3-7-sonnet-20250219 # Recommended models: claude-3-7-sonnet-20250219, claude-3-opus-20240229
PERPLEXITY_MODEL=sonar-pro # Make sure you have access to sonar-pro otherwise you can use sonar regular
MAX_TOKENS=4000 # Maximum tokens for model responses
TEMPERATURE=0.7 # Temperature for model responses (0.0-1.0)

# Task Management Configuration
DEFAULT_SUBTASKS=3 # Default number of subtasks when expanding
DEFAULT_PRIORITY=medium # Default priority for generated tasks (high, medium, low)
PROJECT_NAME=crypto-backend-full # Project name for tasks.json metadata
